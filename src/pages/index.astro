---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

const { t, lang } = Astro.locals;
---

<Layout title={t('appName')} lang={lang}>
	<header class="border-b border-hairline">
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
			<span class="font-mono text-xs uppercase tracking-wide text-mute">{t('appName')}</span>
			<a href="/login" class="text-sm font-medium text-ink hover:text-accent">{t('nav.login')}</a>
		</div>
	</header>

	<main>
		<section class="hero-mesh border-b border-hairline">
			<div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
				<p class="font-mono text-xs uppercase tracking-wide text-accent-deep">{t('hero.eyebrow')}</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
					{t('hero.title')}
				</h1>
				<p class="mt-6 max-w-xl text-lg text-body">{t('hero.subtitle')}</p>
				<p class="mt-6 inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-4 py-2 text-sm font-medium text-accent-deep">
					<Icon name="rupee" class="h-4 w-4" />
					{t('hero.rateNote')}
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button href="/login?role=admin" size="lg">{t('hero.ctaPrimary')}</Button>
					<Button href="/login?role=worker" variant="secondary" size="lg">{t('hero.ctaSecondary')}</Button>
				</div>
			</div>
		</section>

		<section class="border-b border-hairline">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<p class="font-mono text-xs uppercase tracking-wide text-mute">{t('story.eyebrow')}</p>
				<h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-ink">{t('story.title')}</h2>
				<p class="mt-5 max-w-2xl text-base leading-relaxed text-body">{t('story.body')}</p>
			</div>
		</section>

		<section class="border-b border-hairline bg-canvas-elevated">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<p class="font-mono text-xs uppercase tracking-wide text-mute">{t('how.eyebrow')}</p>
				<h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink">{t('how.title')}</h2>
				<div class="mt-12 grid gap-8 sm:grid-cols-3">
					{
						[
							[t('how.step1Title'), t('how.step1Body'), 'calendar' as const],
							[t('how.step2Title'), t('how.step2Body'), 'truck' as const],
							[t('how.step3Title'), t('how.step3Body'), 'rupee' as const],
						].map(([title, body, icon]) => (
							<div class="rounded-lg border border-hairline p-6">
								<span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent-soft text-accent-deep">
									<Icon name={icon} class="h-5 w-5" />
								</span>
								<h3 class="mt-4 text-lg font-semibold text-ink">{title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-body">{body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-b border-hairline">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="text-3xl font-semibold tracking-tight text-ink">{t('trust.title')}</h2>
				<ul class="mt-8 grid gap-4 sm:grid-cols-3">
					{
						[
							[t('trust.point1'), 'leaf' as const],
							[t('trust.point2'), 'shield' as const],
							[t('trust.point3'), 'user' as const],
						].map(([point, icon]) => (
							<li class="flex gap-3 rounded-lg bg-accent-soft p-5 text-sm leading-relaxed text-accent-deep">
								<Icon name={icon} class="mt-0.5 h-5 w-5 shrink-0" />
								<span>{point}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-b border-hairline bg-canvas-elevated">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<p class="font-mono text-xs uppercase tracking-wide text-mute">{t('pricing.eyebrow')}</p>
				<div class="mt-3 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
					<div class="max-w-xl">
						<h2 class="text-3xl font-semibold tracking-tight text-ink">{t('pricing.title')}</h2>
						<p class="mt-4 text-base leading-relaxed text-body">{t('pricing.body')}</p>
					</div>
					<div class="flex items-center gap-4 rounded-lg border border-hairline p-6">
						<span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-deep">
							<Icon name="rupee" class="h-6 w-6" />
						</span>
						<div>
							<p class="text-2xl font-semibold tracking-tight text-ink">₹100<span class="text-base font-normal text-mute">/L</span></p>
							<p class="text-sm text-mute">{t('common.morning')} · {t('common.evening')}</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-ink text-on-primary">
			<div class="mx-auto max-w-6xl px-6 py-20 text-center">
				<h2 class="text-3xl font-semibold tracking-tight">{t('contact.title')}</h2>
				<p class="mx-auto mt-4 max-w-lg text-base text-white/70">{t('contact.body')}</p>
				<div class="mt-8">
					<Button href="tel:+910000000000" size="lg" variant="inverse">
						{t('contact.callCta')}
					</Button>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-hairline bg-hairline-soft">
		<div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 text-sm text-mute sm:flex-row sm:justify-between">
			<span>{t('footer.location')}</span>
			<span>{t('footer.rights')}</span>
		</div>
	</footer>
</Layout>
