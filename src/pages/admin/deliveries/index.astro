---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import MilkDoodle from '../../../components/ui/MilkDoodle.astro';
import { actions } from 'astro:actions';
import { getDayView } from '../../../lib/db/deliveries';

const { t } = Astro.locals;

function addDays(date: string, delta: number): string {
	const d = new Date(`${date}T00:00:00`);
	d.setDate(d.getDate() + delta);
	return d.toISOString().slice(0, 10);
}

const date = Astro.url.searchParams.get('date') ?? new Date().toISOString().slice(0, 10);
Astro.getActionResult(actions.deliveries.mark);
const entries = getDayView(date);
---

<AdminLayout title={t('admin.deliveries.title')} active="deliveries">
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="flex items-center gap-2 text-2xl font-semibold tracking-tight text-ink">
			{t('admin.deliveries.title')}
			<MilkDoodle variant="carton" class="h-6 w-6" />
		</h1>
		<div class="flex items-center gap-2">
			<a href={`/admin/deliveries?date=${addDays(date, -1)}`} class="rounded-md border border-hairline px-3 py-1.5 text-sm text-body hover:bg-hairline-soft">
				{t('admin.deliveries.prev')}
			</a>
			<span class="rounded-md bg-hairline-soft px-3 py-1.5 text-sm font-medium text-ink">{date}</span>
			<a href={`/admin/deliveries?date=${addDays(date, 1)}`} class="rounded-md border border-hairline px-3 py-1.5 text-sm text-body hover:bg-hairline-soft">
				{t('admin.deliveries.next')}
			</a>
		</div>
	</div>

	<section class="mt-6">
		<h2 class="flex items-center gap-1.5 text-lg font-semibold text-ink">
			<MilkDoodle variant="drop" class="h-4 w-4" />
			{t('admin.deliveries.morningShift')}
		</h2>
		<div class="mt-3 overflow-x-auto rounded-lg border border-hairline bg-canvas-elevated">
			<table class="w-full text-left text-sm">
				<thead class="border-b border-hairline text-mute">
					<tr>
						<th class="px-4 py-3 font-medium">{t('common.name')}</th>
						<th class="px-4 py-3 font-medium">{t('admin.deliveries.plannedQty')}</th>
						<th class="px-4 py-3 font-medium">{t('common.status')}</th>
						<th class="px-4 py-3 font-medium">{t('admin.deliveries.markExtra')}</th>
						<th class="px-4 py-3 font-medium" />
					</tr>
				</thead>
				<tbody>
					{entries.map((entry) => (
						<tr class="border-b border-hairline-soft last:border-0">
							<td class="px-4 py-3">
								<a href={`/admin/customers/${entry.customer.id}`} class="font-medium text-ink hover:text-accent">
									{entry.customer.name}
								</a>
							</td>
							<td class="px-4 py-3 text-body">{entry.plannedQuantity} {t('common.liters')}</td>
							<td class="px-4 py-3">
								{entry.record ? (
									<span
										class:list={[
											'rounded-full px-2 py-0.5 text-xs font-medium',
											entry.record.status === 'delivered' ? 'bg-accent-soft text-accent-deep' : 'bg-warning-soft text-warning-deep',
										]}
									>
										{entry.record.status === 'delivered' ? t('admin.deliveries.markDelivered') : t('admin.deliveries.markSkip')}
									</span>
								) : (
									<span class="text-xs text-mute">{t('admin.deliveries.notMarked')}</span>
								)}
							</td>
							<td class="px-4 py-3 text-body">{entry.record?.extra_quantity || '—'}</td>
							<td class="px-4 py-3">
								<form method="POST" action={actions.deliveries.mark} class="flex items-center gap-2">
									<input type="hidden" name="customer_id" value={entry.customer.id} />
									<input type="hidden" name="date" value={date} />
									<input
										type="number"
										name="extra_quantity"
										step="0.1"
										min="0"
										value={entry.record?.extra_quantity ?? 0}
										class="w-16 rounded-md border border-hairline px-2 py-1 text-sm outline-none focus:border-ink"
									/>
									<input type="hidden" name="actual_quantity" value={entry.plannedQuantity} />
									<button
										type="submit"
										name="status"
										value="delivered"
										class="rounded-md bg-accent px-3 py-1.5 text-xs font-medium text-white hover:bg-accent-deep"
									>
										{t('admin.deliveries.markDelivered')}
									</button>
									<button
										type="submit"
										name="status"
										value="skipped"
										class="rounded-md border border-hairline px-3 py-1.5 text-xs font-medium text-body hover:bg-hairline-soft"
									>
										{t('admin.deliveries.markSkip')}
									</button>
								</form>
							</td>
						</tr>
					))}
					{entries.length === 0 && (
						<tr><td colspan="5" class="px-4 py-4 text-center text-mute">{t('worker.noCustomers')}</td></tr>
					)}
				</tbody>
			</table>
		</div>
	</section>
</AdminLayout>
