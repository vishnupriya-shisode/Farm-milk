---
import Layout from '../../layouts/Layout.astro';
import MilkDoodle from '../../components/ui/MilkDoodle.astro';
import { actions } from 'astro:actions';
import { getDayView } from '../../lib/db/deliveries';

const { t, lang, user } = Astro.locals;
Astro.getActionResult(actions.deliveries.mark);

const date = new Date().toISOString().slice(0, 10);
const entries = getDayView(date);
const grouped = {
	morning: entries.filter((e) => e.shift === 'morning'),
	evening: entries.filter((e) => e.shift === 'evening'),
};
---

<Layout title={`${t('worker.title')} · ${t('appName')}`} lang={lang}>
	<div class="min-h-screen bg-canvas">
		<header class="sticky top-0 z-10 border-b border-hairline bg-canvas-elevated px-6 py-4">
			<div class="flex items-center justify-between">
				<div>
					<p class="flex items-center gap-1.5 font-mono text-xs uppercase tracking-wide text-mute">
						<MilkDoodle variant="drop" class="h-4 w-4" />
						{t('appName')}
					</p>
					<h1 class="text-lg font-semibold text-ink">{t('worker.title')}</h1>
				</div>
				<form method="POST" action="/logout">
					<button type="submit" class="text-sm font-medium text-ink hover:text-accent">{t('common.logout')}</button>
				</form>
			</div>
			<p class="mt-1 text-sm text-mute">{user?.name} · {date}</p>
		</header>

		<main class="mx-auto max-w-lg px-4 py-6">
			<p class="text-sm text-body">{t('worker.subtitle')}</p>

			{
				(['morning', 'evening'] as const).map((shift) => (
					<section class="mt-6">
						<h2 class="text-sm font-semibold uppercase tracking-wide text-mute">
							{shift === 'morning' ? t('worker.morning') : t('worker.evening')}
						</h2>
						<div class="mt-3 space-y-3">
							{grouped[shift].map((entry) => (
								<div class="rounded-lg border border-hairline bg-canvas-elevated p-4">
									<div class="flex items-center justify-between">
										<div>
											<p class="font-medium text-ink">{entry.customer.name}</p>
											<p class="text-sm text-mute">{entry.plannedQuantity} {t('common.liters')}</p>
										</div>
										{entry.record && (
											<span
												class:list={[
													'rounded-full px-2 py-0.5 text-xs font-medium',
													entry.record.status === 'delivered' ? 'bg-accent-soft text-accent-deep' : 'bg-warning-soft text-warning-deep',
												]}
											>
												{entry.record.status === 'delivered' ? t('worker.doneTag') : t('admin.deliveries.markSkip')}
											</span>
										)}
									</div>
									<form method="POST" action={actions.deliveries.mark} class="mt-3 flex gap-2">
										<input type="hidden" name="customer_id" value={entry.customer.id} />
										<input type="hidden" name="date" value={date} />
										<input type="hidden" name="shift" value={shift} />
										<input type="hidden" name="actual_quantity" value={entry.plannedQuantity} />
										<input type="hidden" name="extra_quantity" value={entry.record?.extra_quantity ?? 0} />
										<button
											type="submit"
											name="status"
											value="delivered"
											class="h-10 flex-1 rounded-[100px] bg-accent text-sm font-medium text-white hover:bg-accent-deep"
										>
											{t('worker.delivered')}
										</button>
										<button
											type="submit"
											name="status"
											value="skipped"
											class="h-10 flex-1 rounded-[100px] border border-hairline text-sm font-medium text-body hover:bg-hairline-soft"
										>
											{t('worker.skip')}
										</button>
									</form>
								</div>
							))}
							{grouped[shift].length === 0 && (
								<p class="rounded-lg border border-dashed border-hairline p-4 text-center text-sm text-mute">
									{t('worker.noCustomers')}
								</p>
							)}
						</div>
					</section>
				))
			}
		</main>
	</div>
</Layout>
